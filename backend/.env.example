# Server
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/facechat

# Redis
REDIS_URL=redis://localhost:6379

# Session
SESSION_SECRET=your-super-secret-session-key-change-in-production

# JWT
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# TURN Server
TURN_SERVER=turn:your-turn-server.com:3478
TURN_USERNAME=your-turn-username
TURN_PASSWORD=your-turn-password
STUN_SERVER=stun:stun.l.google.com:19302

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Email (for password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=FaceChat <noreply@facechat.app>

# Admin
ADMIN_SECRET=your-admin-secret-token

# ============================================================
# BUSINESS CONFIGURATION - Adjust without touching core logic
# ============================================================

# Guest session limit in minutes
GUEST_FREE_MINUTES=10

# Guest warning shown N minutes before limit
GUEST_WARNING_MINUTES=2

# Coins earned per minute of conversation (authenticated users)
COINS_EARNED_PER_MINUTE=10

# Coins spent per minute of conversation
COINS_SPENT_PER_MINUTE=5

# Low balance threshold for notification
LOW_BALANCE_THRESHOLD=100

# Coin bundle
COIN_BUNDLE_AMOUNT=1000
COIN_BUNDLE_PRICE_USD=10

# Female Match Pass
FEMALE_PASS_PRICE_USD=2
FEMALE_PASS_DURATION_HOURS=12

# New user signup bonus coins
SIGNUP_BONUS_COINS=100

# Milestone bonuses (JSON)
MILESTONE_BONUSES=[{"minuteMilestone":5,"coins":50},{"minuteMilestone":15,"coins":100},{"minuteMilestone":30,"coins":250}]

# Rate limiting
MAX_MATCHES_PER_HOUR=60
MAX_REPORTS_PER_HOUR=10
MAX_LOGIN_ATTEMPTS=5
